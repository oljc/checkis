{
  "name": "checkis-monorepo",
  "private": true,
  "author": "oljc",
  "license": "MIT",
  "scripts": {
    "gen": "tsx scripts/gen.ts",
    "dev": "pnpm --filter website dev",
    "build": "pnpm run gen && pnpm --filter checkis build",
    "build:website": "pnpm --filter website build",
    "publish": "pnpm run build && tsx scripts/publish.ts",
    "test": "pnpm --filter checkis test",
    "test:dev": "pnpm --filter checkis test:dev",
    "check": "biome check",
    "check:write": "biome check --write",
    "check:types": "pnpm -r run check:types",
    "format": "biome format --write",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.3",
    "@changesets/cli": "^3.0.0",
    "@commitlint/cli": "^21.0.0",
    "@commitlint/config-conventional": "^21.0.0",
    "@types/node": "^24.10.0",
    "fast-glob": "^3.3.3",
    "fs-extra": "^11.3.2",
    "lefthook": "^2.0.2",
    "tsx": "^4.20.6",
    "typescript": "^7.0.0"
  },
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=10.19.0"
  }
}
